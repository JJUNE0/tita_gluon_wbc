<mujoco model="tita">
  <!--
    Corrected MJCF — 2026-07-08

    Source of truth: ddt_ros2_control/urdfs/tita_description/urdf/robot.urdf
    Isaac Lab config: source/ddt_lab/ddt_lab/assets/ddt_robot.py (DDT_TITA_CFG)
      spawn: UrdfFileCfg, merge_fixed_joints=True
      legs actuator: DCMotorCfg stiffness=60 damping=1.5 effort_limit=60
      wheels actuator: ImplicitActuatorCfg stiffness=0 damping=0.5 effort_limit_sim=12

    Changes from original mujoco/robot.xml:
      - All <inertial> values replaced with URDF source values.
        base_link mass includes merged imu_link (0.001 kg) to match Isaac
        merge_fixed_joints=True behaviour.
        Off-diagonal inertia terms from URDF are preserved via fullinertia.
      - Joint damping changed from 0.1 -> 0.0 (Isaac PhysX joint drive
        damping is 0; controller kd=1.5 is supplied externally by cosim).
      - frictionloss changed from 0.2 -> 0.0 (Isaac actuator friction=0).
      - armature kept at 0.01 (small regulariser, not present in Isaac but
        negligible effect).
      - Leg actuators: forcerange="-60 60" (Isaac effort_limit=60 Nm).
      - Wheel actuators: forcerange="-12 12" (Isaac effort_limit_sim=12 Nm).
      - All geometry, kinematics, sensors unchanged.

    DO NOT EDIT by hand.  Change the source URDF and re-run the patch if
    robot parameters change.
  -->
  <compiler angle="radian" meshdir="../meshes/" autolimits="true" />
  <option cone="elliptic" impratio="100" />
  <default>
    <default class="tita">
      <!-- geom friction kept from original; contact geometry is correct -->
      <geom friction="0.4" margin="0.001" condim="1"/>
      <!--
        damping=0: Isaac PhysX ArticulationDrive damping is explicitly 0
                   (UrdfFileCfg joint_drive gains stiffness=0, damping=0).
                   cosim controller kd (1.5 legs / 0.5 wheels) supplies damping.
        frictionloss=0: Isaac actuator friction=0 for all joints.
        armature=0.01: small regularisation only, not in Isaac model.
      -->
      <joint axis="0 1 0" damping="0.0" armature="0.01" frictionloss="0.0"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom group="3" />
      </default>
    </default>
  </default>
  <asset>
    <material name="metal" rgba=".9 .95 .95 1" />
    <material name="black" rgba="0 0 0 1" />
    <material name="white" rgba="1 1 1 1" />
    <material name="gray" rgba="0.671705 0.692426 0.774270 1" />

    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="left_leg_1" file="left_leg_1.STL"/>
    <mesh name="left_leg_2" file="left_leg_2.STL"/>
    <mesh name="left_leg_3" file="left_leg_3.STL"/>
    <mesh name="left_leg_4" file="left_leg_4.STL"/>
    <mesh name="right_leg_1" file="right_leg_1.STL"/>
    <mesh name="right_leg_2" file="right_leg_2.STL"/>
    <mesh name="right_leg_3" file="right_leg_3.STL"/>
    <mesh name="right_leg_4" file="right_leg_4.STL"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0.8" childclass="tita">
      <!--
        URDF base_link mass: 11.36226789 kg
        + imu_link (fixed child, merged by Isaac merge_fixed_joints=True): 0.001 kg
        = 11.36326789 kg  (matches Isaac physics dump nominal: 11.36326789855957)

        COM from URDF: xyz="0.01335116 3.5457E-06 0.01863129"
        imu_link is at origin so merged COM shift is negligible.

        Inertia: full tensor from URDF base_link (imu_link inertia 0.0001*I negligible)
        URDF: ixx=0.10777013 ixy=-0.00184576 ixz=0.01392083
              iyy=0.25823486 iyz=-0.00010712
              izz=0.31221040
        MuJoCo fullinertia format: ixx iyy izz ixy ixz iyz
      -->
      <inertial pos="0.01335116 3.5457E-06 0.01863129"
                mass="11.36326789"
                fullinertia="0.10777013 0.25823486 0.31221040 -0.00184576 0.01392083 -0.00010712"/>
      <freejoint />
      <site name="trunk_imu" size="0.01"/>
      <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="base_link"/>
      <geom size="0.235 0.15 0.095" pos="0 0 0.017" type="box" class="collision" rgba="0.196078 0.196078 0.196078 1"/>
      <body name="left_leg_1" pos="0 0.0895 0" quat="0.499998 0.5 0.500002 0.5">
        <!--
          URDF left_leg_1: mass=2.064 COM=(0.001602, 0.000050, 0.000638)
          fullinertia (ixx iyy izz ixy ixz iyz):
            ixx=0.004370 iyy=0.004060 izz=0.003268
            ixy=0.000001 ixz=0.000055 iyz=-0.000001
        -->
        <inertial pos="0.001602 0.000050 0.000638"
                  mass="2.064"
                  fullinertia="0.004370 0.004060 0.003268 0.000001 0.000055 -0.000001"/>
        <joint name="joint_left_leg_1" pos="0 0 0" axis="0 0 1" range="-0.785398 0.785398" actuatorfrcrange="-100 100"/>
        <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="left_leg_1"/>
        <body name="left_leg_2" pos="0.1426 0 0" quat="0.499998 -0.5 0.500002 -0.5">
          <!--
            URDF left_leg_2: mass=3.018005 COM=(0.021183, 0.000354, -0.028971)
            fullinertia: ixx=0.005749 iyy=0.014415 izz=0.013964
                         ixy=-0.000167 ixz=-0.001863 iyz=-0.000122
          -->
          <inertial pos="0.021183 0.000354 -0.028971"
                    mass="3.018005"
                    fullinertia="0.005749 0.014415 0.013964 -0.000167 -0.001863 -0.000122"/>
          <joint name="joint_left_leg_2" pos="0 0 0" axis="0 0 1" range="-1.91986 3.49066" actuatorfrcrange="-100 100"/>
          <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="left_leg_2"/>
          <body name="left_leg_3" pos="0.2 0 0">
            <!--
              URDF left_leg_3: mass=0.57244 COM=(0.095348, 0.011698, 0.001838)
              fullinertia: ixx=0.000363 iyy=0.004094 izz=0.004292
                           ixy=0.000237 ixz=-0.000109 iyz=0.000017
            -->
            <inertial pos="0.095348 0.011698 0.001838"
                      mass="0.57244"
                      fullinertia="0.000363 0.004094 0.004292 0.000237 -0.000109 0.000017"/>
            <joint name="joint_left_leg_3" pos="0 0 0" axis="0 0 1" range="-2.67035 -0.698132" actuatorfrcrange="-100 100"/>
            <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="left_leg_3"/>
            <geom size="0.1 0.035 0.025" pos="0.1 0.021 -0.002" quat="0.997856 0 0 -0.0654532" type="box" class="collision" rgba="0.196078 0.196078 0.196078 1"/>
            <body name="left_leg_4" pos="0.2 0 0.0514">
              <!--
                URDF left_leg_4: mass=1.5094 COM=(-2.267E-06, -1.6471E-06, -0.00095616)
                fullinertia: ixx=0.003615 iyy=0.003574 izz=0.006905
                             ixy=6.9816E-06 ixz=-2.3224E-07 iyz=-1.7712E-08
              -->
              <inertial pos="-2.267E-06 -1.6471E-06 -0.00095616"
                        mass="1.5094"
                        fullinertia="0.003615 0.003574 0.006905 6.9816E-06 -2.3224E-07 -1.7712E-08"/>
              <joint name="joint_left_leg_4" pos="0 0 0" axis="0 0 1" range="-62831.8 62831.8" actuatorfrcrange="-100 100"/>
              <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="left_leg_4"/>
              <geom size="0.0925 0.017" type="cylinder" class="collision" rgba="0.196078 0.196078 0.196078 1"/>
            </body>
          </body>
        </body>
      </body>
      <body name="right_leg_1" pos="0 -0.0895 0" quat="0.499998 0.5 0.500002 0.5">
        <!--
          URDF right_leg_1: mass=2.064 COM=(-0.001602, 0.000050, 0.000638)
          fullinertia: ixx=0.004370 iyy=0.004060 izz=0.003268
                       ixy=-0.000001 ixz=-0.000055 iyz=-0.000001
        -->
        <inertial pos="-0.001602 0.000050 0.000638"
                  mass="2.064"
                  fullinertia="0.004370 0.004060 0.003268 -0.000001 -0.000055 -0.000001"/>
        <joint name="joint_right_leg_1" pos="0 0 0" axis="0 0 1" range="-0.785398 0.785398" actuatorfrcrange="-100 100"/>
        <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="right_leg_1"/>
        <body name="right_leg_2" pos="-0.1426 0 0" quat="0.499998 -0.5 0.500002 -0.5">
          <!--
            URDF right_leg_2: mass=3.018005 COM=(0.021183, 0.000354, 0.028971)
            fullinertia: ixx=0.005749 iyy=0.014415 izz=0.013964
                         ixy=-0.000167 ixz=0.001863 iyz=0.000122
          -->
          <inertial pos="0.021183 0.000354 0.028971"
                    mass="3.018005"
                    fullinertia="0.005749 0.014415 0.013964 -0.000167 0.001863 0.000122"/>
          <joint name="joint_right_leg_2" pos="0 0 0" axis="0 0 1" range="-1.91986 3.49066" actuatorfrcrange="-100 100"/>
          <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="right_leg_2"/>
          <body name="right_leg_3" pos="0.2 0 0">
            <!--
              URDF right_leg_3: mass=0.57244 COM=(0.095348, 0.011698, -0.001838)
              fullinertia: ixx=0.000363 iyy=0.004094 izz=0.004292
                           ixy=0.000237 ixz=0.000109 iyz=-0.000017
            -->
            <inertial pos="0.095348 0.011698 -0.001838"
                      mass="0.57244"
                      fullinertia="0.000363 0.004094 0.004292 0.000237 0.000109 -0.000017"/>
            <joint name="joint_right_leg_3" pos="0 0 0" axis="0 0 1" range="-2.67035 -0.698132" actuatorfrcrange="-100 100"/>
            <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="right_leg_3"/>
            <geom size="0.1 0.035 0.025" pos="0.1 0.021 -0.002" quat="0.997856 0 0 -0.0654532" type="box" class="collision" rgba="0.196078 0.196078 0.196078 1"/>
            <body name="right_leg_4" pos="0.2 0 -0.0514">
              <!--
                URDF right_leg_4: mass=1.5094 COM=(-2.3798E-06, -1.5854E-06, 0.00095595)
                fullinertia: ixx=0.003615 iyy=0.003574 izz=0.006905
                             ixy=7.0548E-06 ixz=2.3146E-07 iyz=1.9287E-08
              -->
              <inertial pos="-2.3798E-06 -1.5854E-06 0.00095595"
                        mass="1.5094"
                        fullinertia="0.003615 0.003574 0.006905 7.0548E-06 2.3146E-07 1.9287E-08"/>
              <joint name="joint_right_leg_4" pos="0 0 0" axis="0 0 1" range="-62831.8 62831.8" actuatorfrcrange="-100 100"/>
              <geom type="mesh" class="visual" density="0" rgba="0.196078 0.196078 0.196078 1" mesh="right_leg_4"/>
              <geom size="0.0925 0.017" type="cylinder" class="collision" rgba="0.196078 0.196078 0.196078 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- leg joints: Isaac effort_limit=60 Nm (DCMotorCfg saturation_effort=80) -->
    <motor name="left_leg_1"  joint="joint_left_leg_1"  forcerange="-60 60"/>
    <motor name="left_leg_2"  joint="joint_left_leg_2"  forcerange="-60 60"/>
    <motor name="left_leg_3"  joint="joint_left_leg_3"  forcerange="-60 60"/>
    <!-- wheel joints: Isaac effort_limit_sim=12 Nm (ImplicitActuatorCfg) -->
    <motor name="left_leg_4"  joint="joint_left_leg_4"  forcerange="-12 12"/>

    <motor name="right_leg_1" joint="joint_right_leg_1" forcerange="-60 60"/>
    <motor name="right_leg_2" joint="joint_right_leg_2" forcerange="-60 60"/>
    <motor name="right_leg_3" joint="joint_right_leg_3" forcerange="-60 60"/>
    <motor name="right_leg_4" joint="joint_right_leg_4" forcerange="-12 12"/>
  </actuator>

  <sensor>
    <jointpos name="left_leg_1_pos"  joint="joint_left_leg_1" />
    <jointpos name="left_leg_2_pos"  joint="joint_left_leg_2" />
    <jointpos name="left_leg_3_pos"  joint="joint_left_leg_3" />
    <jointpos name="left_leg_4_pos"  joint="joint_left_leg_4" />

    <jointpos name="right_leg_1_pos" joint="joint_right_leg_1" />
    <jointpos name="right_leg_2_pos" joint="joint_right_leg_2" />
    <jointpos name="right_leg_3_pos" joint="joint_right_leg_3" />
    <jointpos name="right_leg_4_pos" joint="joint_right_leg_4" />

    <jointvel name="left_leg_1_vel"  joint="joint_left_leg_1" />
    <jointvel name="left_leg_2_vel"  joint="joint_left_leg_2" />
    <jointvel name="left_leg_3_vel"  joint="joint_left_leg_3" />
    <jointvel name="left_leg_4_vel"  joint="joint_left_leg_4" />

    <jointvel name="right_leg_1_vel" joint="joint_right_leg_1" />
    <jointvel name="right_leg_2_vel" joint="joint_right_leg_2" />
    <jointvel name="right_leg_3_vel" joint="joint_right_leg_3" />
    <jointvel name="right_leg_4_vel" joint="joint_right_leg_4" />

    <jointactuatorfrc name="left_leg_1_torque"  joint="joint_left_leg_1"  noise="0.01" />
    <jointactuatorfrc name="left_leg_2_torque"  joint="joint_left_leg_2"  noise="0.01" />
    <jointactuatorfrc name="left_leg_3_torque"  joint="joint_left_leg_3"  noise="0.01" />
    <jointactuatorfrc name="left_leg_4_torque"  joint="joint_left_leg_4"  noise="0.01" />

    <jointactuatorfrc name="right_leg_1_torque" joint="joint_right_leg_1" noise="0.01"/>
    <jointactuatorfrc name="right_leg_2_torque" joint="joint_right_leg_2" noise="0.01"/>
    <jointactuatorfrc name="right_leg_3_torque" joint="joint_right_leg_3" noise="0.01"/>
    <jointactuatorfrc name="right_leg_4_torque" joint="joint_right_leg_4" noise="0.01"/>

    <framequat name="trunk_quat"  objtype="site" objname="trunk_imu" />
    <gyro      name="trunk_gyro"  site="trunk_imu" />
    <accelerometer name="trunk_accel" site="trunk_imu" />

    <framepos    name="frame_pos" objtype="site" objname="trunk_imu" />
    <framelinvel name="frame_vel" objtype="site" objname="trunk_imu" />
  </sensor>

</mujoco>
