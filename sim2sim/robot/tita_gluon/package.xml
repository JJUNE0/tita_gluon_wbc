<?xml version="1.0"?>
<package format="3">
  <name>tita_gluon_urdf</name>
  <version>0.1.0</version>
  <description>TITA and Gluon combined models and RViz2 viewers.</description>

  <maintainer email="maintainer@example.com">TITA Gluon Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>tita_urdf</exec_depend>
  <exec_depend>gluon_2l6_4l3_urdf</exec_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
