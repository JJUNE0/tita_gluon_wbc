<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ros2control" params="hw_env:='none' hardware_output_enabled:='false' wheel_effort_limit:='20.0'">
    <xacro:if value="${hw_env != 'none'}">
      <gazebo reference="imu_link">
        <gravity>true</gravity>
        <sensor name="trunk_imu" type="imu">
          <always_on>true</always_on>
          <update_rate>500</update_rate>
          <visualize>true</visualize>
          <topic>__default_topic__</topic>
          <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
            <topicName>trunk_imu</topicName>
            <bodyName>imu_link</bodyName>
            <updateRateHZ>1000.0</updateRateHZ>
            <gaussianNoise>0.00</gaussianNoise>
            <xyzOffset>0 0 0</xyzOffset>
            <rpyOffset>0 0 0</rpyOffset>
            <frameName>imu_link</frameName>
          </plugin>
          <pose>0 0 0 0 0 0</pose>
        </sensor>
      </gazebo>

      <xacro:if value="${hw_env == 'webots'}">
        <webots>
          <plugin type="webots_ros2_control::Ros2Control" />
        </webots>
      </xacro:if>
      <xacro:if value="${hw_env == 'gazebo'}">
        <gazebo>
          <is_static>true</is_static>
          <self_collide>true</self_collide>
        </gazebo>
        <gazebo>
          <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <!-- <namespace>tita</namespace> -->
            <parameters>$(find gazebo_bridge)/config/controllers.yaml</parameters>
          </plugin>
        </gazebo>
      </xacro:if>
    </xacro:if>

    <ros2_control name="${hw_env}" type="system">
      <hardware>
        <xacro:if value="${hw_env == 'webots'}">
          <plugin>tita_webots_ros2_control::WebotsBridge</plugin>
        </xacro:if>
        <xacro:if value="${hw_env == 'gazebo'}">
          <plugin>usr_gazebo_ros2_control/GazeboBridge</plugin>
        </xacro:if>
        <xacro:if value="${hw_env == 'hw'}">
          <plugin>tita_locomotion::HardwareBridge</plugin>
          <param name="pvt_ctrl">false</param>
          <param name="hardware_output_enabled">${hardware_output_enabled}</param>
          <param name="write_failure_threshold">3</param>
          <param name="hardware_log_root">/home/robot/direct_ws/runs</param>
          <param name="logger_fsync_every_records">250</param>
        </xacro:if>
      </hardware>

      <joint name="joint_left_leg_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">-60</param>
          <param name="max">60</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">0.45</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint_left_leg_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">-60</param>
          <param name="max">60</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">1.3</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint_left_leg_3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">-60</param>
          <param name="max">60</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">-2.6</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint_left_leg_4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">${-wheel_effort_limit}</param>
          <param name="max">${wheel_effort_limit}</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint_right_leg_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">-60</param>
          <param name="max">60</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">-0.45</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint_right_leg_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">-60</param>
          <param name="max">60</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">1.3</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint_right_leg_3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">-60</param>
          <param name="max">60</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">-2.6</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint_right_leg_4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort">
          <param name="min">${-wheel_effort_limit}</param>
          <param name="max">${wheel_effort_limit}</param>
        </command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <sensor name="trunk_imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
      <gpio name="hardware_bridge">
        <command_interface name="command_enable"/>
        <command_interface name="stage1_state"/>
        <command_interface name="controller_sequence"/>
        <command_interface name="transform_progress"/>
        <command_interface name="settle_elapsed"/>
        <command_interface name="command_prepared"/>
        <command_interface name="rl_prepare_elapsed"/>
        <command_interface name="rl_blend_alpha"/>
        <command_interface name="rl_running_elapsed"/>
        <command_interface name="history_valid_count"/>
        <command_interface name="inference_ms"/>
        <command_interface name="joy_fresh"/>
        <command_interface name="joy_zero"/>
        <command_interface name="repeated_clipping"/>
        <command_interface name="logger_flush_request"/>
        <command_interface name="joy_age_ms"/>
        <command_interface name="joy_command_vx"/>
        <command_interface name="joy_command_vy"/>
        <command_interface name="joy_command_yaw"/>
        <command_interface name="obs_current0"/>
        <command_interface name="obs_current1"/>
        <command_interface name="obs_current2"/>
        <command_interface name="obs_current3"/>
        <command_interface name="obs_current4"/>
        <command_interface name="obs_current5"/>
        <command_interface name="obs_current6"/>
        <command_interface name="obs_current7"/>
        <command_interface name="obs_current8"/>
        <command_interface name="obs_current9"/>
        <command_interface name="obs_current10"/>
        <command_interface name="obs_current11"/>
        <command_interface name="obs_current12"/>
        <command_interface name="obs_current13"/>
        <command_interface name="obs_current14"/>
        <command_interface name="obs_current15"/>
        <command_interface name="obs_current16"/>
        <command_interface name="obs_current17"/>
        <command_interface name="obs_current18"/>
        <command_interface name="obs_current19"/>
        <command_interface name="obs_current20"/>
        <command_interface name="obs_current21"/>
        <command_interface name="obs_current22"/>
        <command_interface name="obs_current23"/>
        <command_interface name="obs_current24"/>
        <command_interface name="obs_current25"/>
        <command_interface name="obs_current26"/>
        <command_interface name="obs_current27"/>
        <command_interface name="obs_current28"/>
        <command_interface name="obs_current29"/>
        <command_interface name="obs_current30"/>
        <command_interface name="obs_current31"/>
        <command_interface name="obs_current32"/>
        <command_interface name="action_policy0"/>
        <command_interface name="action_policy1"/>
        <command_interface name="action_policy2"/>
        <command_interface name="action_policy3"/>
        <command_interface name="action_policy4"/>
        <command_interface name="action_policy5"/>
        <command_interface name="action_policy6"/>
        <command_interface name="action_policy7"/>
        <command_interface name="action_native0"/>
        <command_interface name="action_native1"/>
        <command_interface name="action_native2"/>
        <command_interface name="action_native3"/>
        <command_interface name="action_native4"/>
        <command_interface name="action_native5"/>
        <command_interface name="action_native6"/>
        <command_interface name="action_native7"/>
        <command_interface name="action_scaled0"/>
        <command_interface name="action_scaled1"/>
        <command_interface name="action_scaled2"/>
        <command_interface name="action_scaled3"/>
        <command_interface name="action_scaled4"/>
        <command_interface name="action_scaled5"/>
        <command_interface name="action_scaled6"/>
        <command_interface name="action_scaled7"/>
        <command_interface name="stand_target0"/>
        <command_interface name="stand_target1"/>
        <command_interface name="stand_target2"/>
        <command_interface name="stand_target3"/>
        <command_interface name="stand_target4"/>
        <command_interface name="stand_target5"/>
        <command_interface name="stand_target6"/>
        <command_interface name="stand_target7"/>
        <command_interface name="rl_target0"/>
        <command_interface name="rl_target1"/>
        <command_interface name="rl_target2"/>
        <command_interface name="rl_target3"/>
        <command_interface name="rl_target4"/>
        <command_interface name="rl_target5"/>
        <command_interface name="rl_target6"/>
        <command_interface name="rl_target7"/>
        <command_interface name="limited_target0"/>
        <command_interface name="limited_target1"/>
        <command_interface name="limited_target2"/>
        <command_interface name="limited_target3"/>
        <command_interface name="limited_target4"/>
        <command_interface name="limited_target5"/>
        <command_interface name="limited_target6"/>
        <command_interface name="limited_target7"/>
        <command_interface name="blended_target0"/>
        <command_interface name="blended_target1"/>
        <command_interface name="blended_target2"/>
        <command_interface name="blended_target3"/>
        <command_interface name="blended_target4"/>
        <command_interface name="blended_target5"/>
        <command_interface name="blended_target6"/>
        <command_interface name="blended_target7"/>
        <command_interface name="clipping_mask0"/>
        <command_interface name="clipping_mask1"/>
        <command_interface name="clipping_mask2"/>
        <command_interface name="clipping_mask3"/>
        <command_interface name="clipping_mask4"/>
        <command_interface name="clipping_mask5"/>
        <command_interface name="clipping_mask6"/>
        <command_interface name="clipping_mask7"/>
        <command_interface name="joy_axis0"/>
        <command_interface name="joy_axis1"/>
        <command_interface name="joy_axis2"/>
        <command_interface name="joy_axis3"/>
        <command_interface name="joy_axis4"/>
        <command_interface name="joy_axis5"/>
        <command_interface name="joy_axis6"/>
        <command_interface name="joy_axis7"/>
        <state_interface name="read_valid"/>
        <state_interface name="write_success"/>
        <state_interface name="write_sequence"/>
        <state_interface name="consecutive_write_failures"/>
        <state_interface name="motors_online"/>
        <state_interface name="dropped_write_log_records"/>
        <state_interface name="hardware_output_enabled"/>
        <state_interface name="motor_api_write_count"/>
        <state_interface name="imu_fresh"/>
        <state_interface name="motors_fresh"/>
        <state_interface name="joint_vectors_valid"/>
        <state_interface name="state_values_finite"/>
        <state_interface name="motor_status_all_online"/>
        <state_interface name="motor_status_available"/>
        <state_interface name="logger_flushed_sequence"/>
        <state_interface name="last_command_q0"/>
        <state_interface name="last_command_q1"/>
        <state_interface name="last_command_q2"/>
        <state_interface name="last_command_q3"/>
        <state_interface name="last_command_q4"/>
        <state_interface name="last_command_q5"/>
        <state_interface name="last_command_q6"/>
        <state_interface name="last_command_q7"/>
      </gpio>
    </ros2_control>

  </xacro:macro>

</robot>
